    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scope" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="otherInfo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DataType">
    <eLiterals name="Int" value="1" literal="Int"/>
    <eLiterals name="float" value="2" literal="float"/>
    <eLiterals name="array" value="3"/>
    <eLiterals name="char" value="4"/>
    <eLiterals name="enum" value="5"/>
    <eLiterals name="structure" value="6" literal="structure"/>
    <eLiterals name="point" value="7"/>
    <eLiterals name="cfile"/>
    <eLiterals name="bool" value="8" literal="bool"/>
    <eLiterals name="union" value="9" literal="union"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AudioMapping" eSuperTypes="#//Mapping">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dataType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dimension" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="raster" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
