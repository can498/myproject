    <eStructuralFeatures xsi:type="ecore:EAttribute" name="shouldsignals" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SignalMapping" eSuperTypes="#//Mapping"/>
  <eClassifiers xsi:type="ecore:EClass" name="DebugMapping" eSuperTypes="#//Mapping">
